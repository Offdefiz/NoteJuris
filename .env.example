# Porta do servidor (padrão: 3000)
PORT=3000

# Integração OpenAI (Análise de Processos e Peças Jurídicas)
# Chave de API oficial da OpenAI (lida estritamente no backend seguro em server.ts)
# Nunca compartilhe nem exponha essa chave publicamente.
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Modelo OpenAI centralizado (padrão econômico e rápido: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# Opcional: Chave de API do Google Gemini (Assistente e Flashcards)
# Se não preenchida, o aplicativo opera no Modo Offline / Modelos Esquematizados 100% autônomo sem internet
GEMINI_API_KEY=""

# URL base do aplicativo (opcional, para deploys com proxy reverso ou subdomínio)
APP_URL="http://localhost:3000"
