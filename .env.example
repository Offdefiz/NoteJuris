# Porta do servidor (padrão: 3000)
PORT=3000

# Opcional: Chave de API do Google Gemini
# Se não preenchida, o aplicativo opera no Modo Offline / Modelos Esquematizados 100% autônomo sem internet
GEMINI_API_KEY=""

# URL base do aplicativo (opcional, para deploys com proxy reverso ou subdomínio)
APP_URL="http://localhost:3000"
